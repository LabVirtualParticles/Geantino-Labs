# Copie este arquivo pra frontend/.env e preencha com os valores reais
# do seu projeto Supabase (Project Settings > API). O .env de verdade
# nunca é commitado (ver .gitignore).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (formato sb_publishable_...) — na página de API do
# Supabase pode aparecer como "Publishable key" (novo sistema) ou, em
# projetos mais antigos, como "anon public" (legado, formato JWT). Os
# dois funcionam aqui, mas prefira a publishable key se disponível.
VITE_SUPABASE_PUBLISHABLE_KEY=coloque-aqui-a-chave-publishable

# Já existente — endereço do backend Python/Geant4 (local ou túnel)
VITE_API_BASE_URL=http://localhost:8000
